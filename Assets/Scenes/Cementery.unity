      objectReference: {fileID: 0}
    - target: {fileID: 5128973835403304750, guid: f58e35b0cf97afe439272e366e075bdf,
        type: 3}
      propertyPath: _mensajeCerrada
      value: "\xBFYa conseguiste las linternas del cobertizo?"
      objectReference: {fileID: 0}
    - target: {fileID: 5128973835403304750, guid: f58e35b0cf97afe439272e366e075bdf,
        type: 3}
      propertyPath: _mensajeAceptada
      value: "Muchas gracias, revisa bien, la habr\xE9 dejado colgada en alguna de
        las casetas."
      objectReference: {fileID: 0}
    - target: {fileID: 5128973835403304750, guid: f58e35b0cf97afe439272e366e075bdf,
        type: 3}
      propertyPath: _mensajeIncopleta
      value: "Parece que a\xFAn no encuentras la llave."
      objectReference: {fileID: 0}
    - target: {fileID: 5128973835403304750, guid: f58e35b0cf97afe439272e366e075bdf,
